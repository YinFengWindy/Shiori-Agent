{
  "typeCheckingMode": "basic",
  "pythonVersion": "3.12",
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": [
    "apps/backend"
  ],
  "include": [
    "apps/backend/main.py",
    "apps/backend/agent",
    "apps/backend/bootstrap",
    "apps/backend/bus",
    "apps/backend/conversation",
    "apps/backend/core",
    "apps/backend/desktop_bridge",
    "apps/backend/infra",
    "apps/backend/memory2",
    "apps/backend/plugins",
    "apps/backend/proactive_v2",
    "apps/backend/prompts",
    "apps/backend/session",
    "apps/backend/story_simulation",
    "apps/backend/utils"
  ],
  "exclude": [
    ".venv",
    ".venv-test",
    "tests",
    "private_tests",
    "private_runtime/scripts",
    "mcp_servers",
    "benchmarks"
  ],
  "reportMissingTypeArgument": "warning",
  "reportPrivateUsage": "warning",
  "reportUnknownParameterType": "warning",
  "reportUnknownArgumentType": "warning",
  "reportUnknownMemberType": "warning",
  "reportUnknownVariableType": "warning",
  "reportUnknownLambdaType": "warning",
  "reportUnusedCallResult": "warning",
  "reportUnusedImport": "warning",
  "reportDeprecated": "warning",
  "reportArgumentType": "error",
  "reportOptionalMemberAccess": "warning",
  "reportAttributeAccessIssue": "warning",
  "reportAssignmentType": "error",
  "reportOperatorIssue": "error",
  "reportCallIssue": "error",
  "reportGeneralTypeIssues": "error",
  "reportMissingImports": "error",
  "reportIndexIssue": "error",
  "reportOptionalSubscript": "warning",
  "reportOptionalCall": "warning",
  "reportOptionalOperand": "warning",
  "reportRedeclaration": "error",
  "reportReturnType": "error",
  "reportUndefinedVariable": "error",
  "reportUnboundVariable": "error"
}
