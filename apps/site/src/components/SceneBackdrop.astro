---
import { sceneBackgrounds } from "../lib/siteAssets";

/**
 * Full-bleed time-of-day scene behind a page section, styled by the desktop's
 * `.scene-backdrop*` classes (shared/adv/adv.css). The static HTML carries
 * the day picture; the script below switches to the visitor's local phase
 * once, on page load, using the desktop's `scenePhaseAt`. Decorative only.
 */
interface Props {
  /** Part of the first screen: fetched first, and the home page loader (SiteLoader.astro) waits for it. */
  firstScreen?: boolean;
}

const { firstScreen = false } = Astro.props;
const { day, dusk, night } = sceneBackgrounds;
---

<div class="scene-backdrop pointer-events-none absolute inset-0" aria-hidden="true">
  <img
    data-scene-backdrop
    data-first-screen={firstScreen ? "" : undefined}
    data-dusk={dusk.src}
    data-night={night.src}
    src={day.src}
    width={day.width}
    height={day.height}
    alt=""
    decoding="async"
    fetchpriority={firstScreen ? "high" : undefined}
    class="scene-backdrop-image h-full w-full object-cover"
  />
  <div class="scene-backdrop-veil absolute inset-0"></div>
</div>

<script>
  import { scenePhaseAt } from "../../../desktop/renderer/src/shared/scene/timeOfDay";

  const phase = scenePhaseAt(new Date());
  if (phase !== "day") {
    for (const image of document.querySelectorAll<HTMLImageElement>("img[data-scene-backdrop]")) {
      const src = image.dataset[phase];
      if (!src) throw new Error(`scene backdrop is missing data-${phase}`);
      image.src = src;
    }
  }
</script>
