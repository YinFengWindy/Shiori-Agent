---
import { siteText } from "../i18n";
import type { Locale } from "../i18n/locales";
import { type GalleryPhoto, galleryPhotos } from "../lib/siteAssets";

/**
 * The CG photo strip closing the showcase (#772): photo prints in a row,
 * slightly tilted, drifting sideways in an endless loop. The row is listed
 * twice so the loop is seamless — the copy is hidden from the accessibility
 * tree; hovering pauses it. Nothing is clickable. Under reduced motion the
 * row stands still and scrolls by hand instead (the copy is dropped).
 */
interface Props {
  locale: Locale;
}

const text = siteText(Astro.props.locale);

/** A print's picture, but for its alt text (the row's own, or none for the copy). */
function printAttributes({ image }: GalleryPhoto) {
  return {
    src: image.src,
    width: image.width,
    height: image.height,
    loading: "lazy",
    decoding: "async",
    draggable: "false",
  } as const;
}
---

<div class="site-photostrip" role="region" aria-label={text.photoStrip.label} tabindex="0">
  <ul class="site-photostrip-track">
    {
      galleryPhotos.map((photo) => (
        <li class="site-photo">
          <img {...printAttributes(photo)} alt={text.art[photo.art]} />
        </li>
      ))
    }
    {/* The loop copy: decorative, its empty alt written out as `alt=""` (#799). */}
    {
      galleryPhotos.map((photo) => (
        <li class="site-photo" data-copy aria-hidden="true">
          <img {...printAttributes(photo)} alt="" />
        </li>
      ))
    }
  </ul>
</div>
