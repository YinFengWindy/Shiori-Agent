---
import { GithubLogoIcon } from "@phosphor-icons/react";
import { cx } from "@yinfengwindy/shiori-sdk";
import { compactPrimaryButtonClass, compactTextButtonClass } from "../../../desktop/renderer/src/shared/styles";
import { controlButtonClass } from "../lib/controlButton";
import { type SiteDictionary, siteText } from "../i18n";
import { type Locale, versionFor } from "../i18n/locales";
import { barIconImage } from "../lib/siteAssets";
import { SITE_LINKS, SITE_NAME, SITE_SECTIONS, homeDownloadHref } from "../lib/siteMeta";
import DownloadButton from "./DownloadButton.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import { SoundToggle } from "./SoundToggle";
import "../styles/header.css";

/**
 * The site's top bar (#773): the app icon and name, then 博客,
 * 更新日志, GitHub, the language switch (#806) — with the music switch on
 * its right on the home page (#810) — and the download button last, in
 * the page's language; a section without a version in it (the English blog
 * and changelog until #807) is linked in Chinese. A thin, translucent light strip
 * in the showcase's colours. The icon and name lead to the home page's
 * closing download state (`/#download`, #797); on the home page itself the
 * narrative glides there instead of reloading (NarrativeStage.astro).
 *
 * `reveal` (home page): out of sight over the narrative, which is a
 * full-screen stage of its own; it slides in from the top once the page
 * has moved on to the showcase and away again on the way back
 * (`lib/siteHeader.ts`). It sits outside the narrative's stage, so the
 * stage's wheel, touch and click stepping never see it. While it shows, its
 * language and music switches stand in for the corner pair (header.css).
 * `fixed` (blog, changelog, which play no music):
 * always there, in the page flow at the top and sticking while scrolling.
 *
 * Phones and small tablets (below `md`, 768px) keep the icon, the name, 博客 and the switches, with
 * GitHub as a tile among them (#814); 更新日志 and the download button drop out
 * — there is no phone version to download, and the footer links the releases.
 */
interface Props {
  locale: Locale;
  mode: "reveal" | "fixed";
  /** The language switch's target: the page in the other language (`languageSwitchHref`). */
  languageHref: string;
  /** The section the page belongs to, marked `aria-current` in the bar. */
  current?: "blog" | "changelog";
  /** The music switch's words, on the page that plays music (the home page): the bar carries the switch. */
  sound?: SiteDictionary["sound"];
}

const { locale, mode, current, languageHref, sound } = Astro.props;
const text = siteText(locale).header;
const linkClass = cx(compactTextButtonClass, "no-underline");
// Off on narrow screens (phones and small tablets, below `md`, 768px), and their stand-ins: see above.
const wideOnlyClass = "max-md:hidden";
const narrowOnlyClass = "md:hidden";
---

<header class="site-header" data-site-header data-mode={mode}>
  <nav class="site-header-bar" aria-label={text.label}>
    <a href={homeDownloadHref(locale)} class="site-header-brand no-underline">
      <img
        src={barIconImage.src}
        width={barIconImage.width}
        height={barIconImage.height}
        alt=""
        loading="lazy"
        decoding="async"
        class="site-header-icon"
      />
      <span class="site-header-name site-story-type">{SITE_NAME}</span>
    </a>
    <div class="site-header-links">
      <a href={versionFor(locale, SITE_SECTIONS.blog)} class={linkClass} aria-current={current === "blog" ? "page" : undefined}>{text.blog}</a>
      <a
        href={versionFor(locale, SITE_SECTIONS.changelog)}
        class={cx(linkClass, wideOnlyClass)}
        aria-current={current === "changelog" ? "page" : undefined}>{text.changelog}</a
      >
      <a href={SITE_LINKS.github} class={cx(linkClass, wideOnlyClass)}>
        <GithubLogoIcon size={18} aria-hidden="true" />
        GitHub
      </a>
      {/* Phones: GitHub as a tile beside the switches, in place of the text link. */}
      <a href={SITE_LINKS.github} class={cx(controlButtonClass, narrowOnlyClass)} aria-label="GitHub" title="GitHub">
        <GithubLogoIcon size={20} aria-hidden="true" />
      </a>
      <LanguageSwitch locale={locale} href={languageHref} variant="bar" />
      {sound && <SoundToggle client:idle className="site-header-sound" labels={sound} />}
      <DownloadButton label={text.download} class={cx(compactPrimaryButtonClass, wideOnlyClass)} iconSize={18} />
    </div>
  </nav>
</header>

<script>
  import { isPastNarrative } from "../lib/siteHeader";

  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (!header) throw new Error("top bar is missing");

  if (header.dataset.mode === "reveal") {
    const narrative = document.querySelector<HTMLElement>("[data-narrative]");
    if (!narrative) throw new Error("the top bar's reveal mode needs the narrative");

    let frame = 0;
    const update = () => {
      frame = 0;
      header.toggleAttribute("data-revealed", isPastNarrative(narrative.getBoundingClientRect().bottom, window.innerHeight));
    };
    const scheduleUpdate = () => {
      frame ||= requestAnimationFrame(update);
    };
    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate);
    update();
  }
</script>
