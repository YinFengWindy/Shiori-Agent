---
import { render } from "astro:content";
import { pageTitle, siteText } from "../i18n";
import { LOCALE_INFO, type Locale, type PageVersions, languageSwitchHref } from "../i18n/locales";
import SiteLayout from "../layouts/SiteLayout.astro";
import { type BlogPost, blogPostPath, formatPostDate, isoPostDate } from "../lib/blog";
import { postTableOfContents } from "../lib/sectionIndex";
import { postShareImage } from "../lib/shareImage";
import { appIconImage } from "../lib/siteAssets";
import { SITE_SECTIONS } from "../lib/siteMeta";
import { inlineJson, organizationJsonLd } from "../lib/structuredData";
import Breadcrumbs from "./Breadcrumbs.astro";
import SectionIndex from "./SectionIndex.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import "../styles/reading.css";
import "../styles/blog.css";

/**
 * One blog post (#773) in one language (#807: `/blog/<slug>/`,
 * `/en/blog/<slug>/`): title, day and byline, the cover if it has one, then
 * the post on a light reading column over the app's wash. The head carries
 * the post's own description, `og:type` article with its publication time,
 * its own share picture made from its cover (#799), and BlogPosting
 * structured data with 吟风 as the author, in the post's language. Its
 * `<title>` keeps the post's own title, in 吟风's voice, and ends with the
 * site's (`pageTitle`).
 *
 * Over the title, the breadcrumb 首页 / 博客 / the post is the way back
 * (#797): its 博客 step is the 「返回博客」 link, so there is no second
 * one. A post with two or more sections gets a table of contents from its
 * rendered headings (their ids are the anchors): beside the column on wide
 * screens, folded under the title on narrow ones (SectionIndex.astro).
 *
 * A post and its translation name each other as alternates; a post with no
 * translation names none, and its language switch leads to the other
 * language's blog.
 */
interface Props {
  locale: Locale;
  post: BlogPost;
  /** The post in every language it is published in (`postVersionsBySlug`). */
  versions: PageVersions;
}

const { locale, post, versions } = Astro.props;
const text = siteText(locale);
const { title, description, date, cover } = post.data;
const { Content, headings } = await render(post);
const tableOfContents = postTableOfContents(headings);
const postPath = blogPostPath(post.id, locale);
const languageHref = languageSwitchHref(locale, versions, "/blog/");
if (!Astro.site) throw new Error("astro.config.ts must set `site`: the post's structured data is built from it");
const postUrl = new URL(postPath, Astro.site).href;
const published = isoPostDate(date);
const shareImage = await postShareImage(cover, locale);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: published,
  inLanguage: LOCALE_INFO[locale].htmlLang,
  url: postUrl,
  mainEntityOfPage: postUrl,
  author: { "@type": "Person", name: text.blog.author },
  publisher: organizationJsonLd(Astro.site, appIconImage.src),
  image: new URL(shareImage.src, Astro.site).href,
};
const structuredDataJson = inlineJson(structuredData);
---

<SiteLayout
  locale={locale}
  versions={versions}
  languageHref={languageHref}
  title={pageTitle(title, locale)}
  description={description}
  ogType="article"
  image={shareImage}
  updated={date}
>
  <Fragment slot="meta">
    <meta property="article:published_time" content={published} />
    <meta property="article:author" content={text.blog.author} />
    <script type="application/ld+json" set:html={structuredDataJson} />
  </Fragment>
  <SiteHeader locale={locale} mode="fixed" current="blog" languageHref={languageHref} />
  <main class="site-reading">
    <div class="site-section-layout">
      <article class="site-reading-column site-section-layout-main">
        <header class="site-post-head">
          <Breadcrumbs
            locale={locale}
            trail={[
              { label: text.blog.title, href: SITE_SECTIONS.blog[locale] },
              { label: title, href: postPath },
            ]}
          />
          <h1 class="site-reading-title site-story-type">{title}</h1>
          <p class="site-reading-meta">
            <time datetime={published}>{formatPostDate(date, locale)}</time>
            <span aria-hidden="true">·</span>
            <span>{text.blog.author}</span>
          </p>
        </header>
        {tableOfContents.length > 0 && <SectionIndex variant="inline" title={text.blog.contents} entries={tableOfContents} />}
        {
          cover && (
            <img
              src={cover.image.src}
              width={cover.image.width}
              height={cover.image.height}
              alt={cover.alt}
              decoding="async"
              class="site-post-cover"
            />
          )
        }
        <div class="site-prose">
          <Content />
        </div>
      </article>
      {tableOfContents.length > 0 && <SectionIndex variant="aside" title={text.blog.contents} entries={tableOfContents} />}
    </div>
  </main>
  <SiteFooter locale={locale} />
</SiteLayout>
