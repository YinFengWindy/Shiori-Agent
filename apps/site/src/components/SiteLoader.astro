---
import { mascotName } from "../../../desktop/renderer/src/shared/mascot/mascotExpressions";
import { NARRATIVE_LINES } from "../content/narrative";
import { narrativeExpressionPlaceholders, narrativeExpressionSprites } from "../lib/siteAssets";

/**
 * The home page loader (#770), the narrative's opening shot before it is
 * ready: over the app's blue-pink wash, 吟风's blurred silhouette stands
 * exactly where her sprite does (it reuses `.site-narrative-figure`), and
 * the dialogue box's 「吟风」 name plate, in its place, fills with the
 * blue-pink accent as the first screen loads — the current scene backdrop
 * and all eight expression sprites (`img[data-first-screen]`), decoded.
 *
 * Then, in place: the wash fades to the scene, the silhouette sharpens into
 * her sprite (it fades off the real one beneath it), the dialogue box rises
 * in with the first line and the name plate hands over to its own. 吟风
 * never moves. Afterwards the loader leaves the DOM and the narrative's CGs
 * are fetched in the background, in order of appearance.
 *
 * Painted with the first frame: the markup, the silhouette (an inline
 * `data:` WebP) and its styles (`.site-loader*` in site.css, inlined with
 * the rest of the CSS, see astro.config.ts) are all in the HTML, and the
 * script is inline. While it shows, wheel / touch / key / click input does
 * not reach the narrative. If the first screen is not ready within
 * `--site-loader-cap` it reveals anyway (the rest keeps loading); without
 * scripting it is never shown, and if the script never runs the CSS fades
 * it at the cap.
 *
 * `aria-hidden`: every word of the page is already in the document beneath
 * it, readable at once; a 「加载中」 status would only be noise.
 */
const [firstLine] = NARRATIVE_LINES;
if (!firstLine) throw new Error("the narrative needs at least one line");
const sprite = narrativeExpressionSprites[firstLine.expression];
const silhouette = narrativeExpressionPlaceholders[firstLine.expression];
---

<div id="site-loader" class="site-loader" aria-hidden="true">
  <div class="site-loader-wash"></div>
  <div class="site-narrative-figure mascot-stack">
    <img
      src={silhouette}
      width={sprite.width}
      height={sprite.height}
      alt=""
      draggable="false"
      class="mascot-layer site-loader-silhouette"
    />
  </div>
  <div class="site-loader-dialogue">
    <p class="site-dialogue-name site-story-type site-loader-plate">{mascotName}</p>
  </div>
</div>

<script is:inline>
  (() => {
    const loader = document.getElementById("site-loader");
    if (!loader) return;
    const root = document.documentElement;
    // Hides the dialogue box until the reveal (site.css).
    root.dataset.siteLoader = "loading";

    // Keep the narrative still while the loader shows: wheel, touch, scroll
    // keys and clicks stop here (capture on window runs before its handlers).
    const SCROLL_KEYS = new Set([" ", "PageDown", "PageUp", "ArrowDown", "ArrowUp", "Home", "End"]);
    const block = (event) => {
      if (event.type === "keydown" && !SCROLL_KEYS.has(event.key)) return;
      if (event.cancelable && event.type !== "touchstart" && event.type !== "touchend") event.preventDefault();
      event.stopImmediatePropagation();
    };
    const guarded = [
      ["wheel", { capture: true, passive: false }],
      ["touchmove", { capture: true, passive: false }],
      ["touchstart", { capture: true, passive: true }],
      ["touchend", { capture: true, passive: true }],
      ["keydown", { capture: true }],
      ["click", { capture: true }],
    ];
    for (const [type, options] of guarded) window.addEventListener(type, block, options);

    // Both fades end in the loader's own animation: then it leaves for good.
    loader.addEventListener("animationend", (event) => {
      if (event.target !== loader) return;
      loader.remove();
      delete root.dataset.siteLoader;
      for (const [type, options] of guarded) window.removeEventListener(type, block, options);
      void prefetchCgs();
    });

    let revealed = false;
    const reveal = () => {
      if (revealed) return;
      revealed = true;
      root.dataset.siteLoader = "revealing";
      loader.setAttribute("data-leaving", "");
    };

    // The cap, from navigation start: `--site-loader-cap` (also the CSS fallback's delay).
    const cap = getComputedStyle(loader).getPropertyValue("--site-loader-cap").trim();
    const capMs = cap.endsWith("ms") ? parseFloat(cap) : parseFloat(cap) * 1000;
    setTimeout(reveal, Math.max(0, capMs - performance.now()));

    // Progress: decoded first-screen images / all of them (a broken one counts).
    const track = () => {
      const images = [...document.querySelectorAll("img[data-first-screen]")];
      let ready = 0;
      const settle = () => {
        ready += 1;
        loader.style.setProperty("--site-loader-progress", String(ready / images.length));
        if (ready === images.length) reveal();
      };
      if (images.length === 0) reveal();
      for (const image of images) image.decode().then(settle, settle);
    };
    // Module scripts (the scene's time-of-day swap) have run by
    // DOMContentLoaded, so the images read then are the ones that will show.
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", track, { once: true });
    else track();

    // After the loader: the CGs, one at a time in order of appearance (their
    // DOM order). Reduced motion lists the lines without CGs: none needed.
    async function prefetchCgs() {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      for (const cg of document.querySelectorAll("img[data-cg][data-src]")) {
        if (!cg.getAttribute("src")) cg.src = cg.dataset.src;
        await cg.decode().catch(() => undefined);
      }
    }
  })();
</script>
