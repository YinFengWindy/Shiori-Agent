---
import { brandMotifPaths } from "@yinfengwindy/shiori-sdk/host-internal";
import { firstScreenImageBytes, loaderArtwork } from "../lib/siteAssets";

/**
 * The home page loader (#770): 吟风's wide illustration (`loaderArtwork`,
 * preloaded first from the page head) fading in over the app's blue-pink
 * wash once decoded, a faint shade along the bottom, a few sakura petals
 * drifting down, and a glowing progress line low and centred — the
 * blue-pink fill with a sweeping highlight, a brand sparkle riding its head
 * with a short light trail, and the percentage above it.
 *
 * The progress counts the narrative's first screen only — the current
 * scene backdrop and all eight expression sprites (`img[data-first-screen]`,
 * which carry `data-src` instead of `src`) — not the illustration, which is
 * the loader's own dressing. The script below downloads them with `fetch`,
 * so the bar can count bytes as they arrive (weighted by the sizes in
 * `data-bytes`, known at build time) and move even on a very slow line. The
 * backdrop and her current face go first, the other faces after them. Each
 * picture is then handed to its `<img>` and decoded.
 *
 * Then: the bar reaches 100% and the sparkle flashes; the whole loader
 * fades out, growing very slightly, onto the narrative's scene while 吟风's
 * sprite fades in, rising the last few pixels into place, and the dialogue
 * box follows with the first line (timings in site.css). Afterwards the
 * loader leaves the DOM. The narrative's CGs are not its business: each is
 * fetched as its line draws near (NarrativeStage.astro, #790).
 *
 * Painted with the first frame: the markup and the styles (`.site-loader*`
 * in site.css, inlined with the rest of the CSS, see astro.config.ts) are
 * in the HTML, and the script is inline. While the loader shows, wheel /
 * touch / key / click input does not reach the narrative — except clicks and
 * keys on the controls shown above the loader, marked
 * `data-loader-passthrough` (the language switch and the English prompt,
 * #806), which work at once. If the first
 * screen is not ready within `--site-loader-cap` it reveals anyway (the
 * rest keeps loading); without scripting it is never shown (the pictures'
 * `<noscript>` copies show), and if the script never runs the CSS fades it
 * at the cap.
 *
 * Not on every visit (#797): on Back / Forward and on an address with an
 * anchor (`/#download`) the head's gate script marks `<html>`
 * `data-site-loader-skip` (lib/siteLoaderGate.ts), site.css hides the loader
 * from the first frame, and the script below removes it and hands the first
 * screen's pictures their `src` at once, with nothing held still.
 *
 * `aria-hidden`: every word of the page is already in the document beneath
 * it, readable at once; a 「加载中」 status would only be noise.
 */

// Petals: horizontal start (% of the width), delay and speed (fractions of
// --site-loader-petal-fall), size (rem). Colours cycle in site.css.
const petals = [
  { x: 8, delay: 0, speed: 1, size: 2 },
  { x: 22, delay: 0.55, speed: 1.25, size: 1.5 },
  { x: 37, delay: 0.2, speed: 0.9, size: 2.4 },
  { x: 51, delay: 0.75, speed: 1.15, size: 1.6 },
  { x: 64, delay: 0.35, speed: 1.05, size: 2.2 },
  { x: 78, delay: 0.9, speed: 0.95, size: 1.7 },
  { x: 90, delay: 0.1, speed: 1.2, size: 1.9 },
];
---

<div id="site-loader" class="site-loader" aria-hidden="true" data-bytes={JSON.stringify(firstScreenImageBytes)}>
  <div class="site-loader-wash"></div>
  <img
    class="site-loader-art"
    src={loaderArtwork.src}
    width={loaderArtwork.width}
    height={loaderArtwork.height}
    alt=""
    decoding="async"
    fetchpriority="high"
    data-loader-art
  />
  <div class="site-loader-shade"></div>
  <div class="site-loader-petals">
    {
      petals.map(({ x, delay, speed, size }) => (
        <svg
          class="site-loader-petal"
          viewBox="0 0 24 24"
          style={`--petal-x: ${x}%; --petal-delay: ${delay}; --petal-speed: ${speed}; --petal-size: ${size}rem`}
        >
          <path d={brandMotifPaths.petal} fill="currentColor" />
        </svg>
      ))
    }
  </div>
  <div class="site-loader-progress">
    <div class="site-loader-track">
      <div class="site-loader-fill"></div>
      <div class="site-loader-head">
        {/* The brand sparkle (cropped to its own 16×16), with a white core. */}
        <svg class="site-loader-star" viewBox="4 4 16 16">
          <path d={brandMotifPaths.sparkle} fill="currentColor" />
          <path
            class="site-loader-star-core"
            d={brandMotifPaths.sparkle}
            fill="currentColor"
            transform="translate(12 12) scale(0.45) translate(-12 -12)"
          />
        </svg>
        <span class="site-loader-percent site-story-type" data-loader-percent>0%</span>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const loader = document.getElementById("site-loader");
    if (!loader) return;
    const root = document.documentElement;

    // Back / Forward or an anchor (the head's gate): no loader, the
    // pictures load straight into their places. Module scripts (the scene's
    // time-of-day swap of data-src) have run by DOMContentLoaded.
    if (root.hasAttribute("data-site-loader-skip")) {
      loader.remove();
      const show = () => {
        for (const image of document.querySelectorAll("img[data-first-screen][data-src]")) image.src = image.dataset.src;
      };
      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", show, { once: true });
      else show();
      return;
    }

    // The illustration fades in over the wash once decoded (site.css).
    const art = loader.querySelector("[data-loader-art]");
    art?.decode().then(
      () => art.setAttribute("data-ready", ""),
      () => undefined,
    );
    // Hides 吟风 and the dialogue box until the reveal (site.css).
    root.dataset.siteLoader = "loading";

    // Keep the narrative still while the loader shows: wheel, touch, scroll
    // keys and clicks stop here (capture on window runs before its handlers),
    // but for those on the controls over the loader.
    const SCROLL_KEYS = new Set([" ", "PageDown", "PageUp", "ArrowDown", "ArrowUp", "Home", "End"]);
    const block = (event) => {
      if (event.type === "keydown" && !SCROLL_KEYS.has(event.key)) return;
      if ((event.type === "click" || event.type === "keydown") && event.target instanceof Element && event.target.closest("[data-loader-passthrough]")) return;
      if (event.cancelable && event.type !== "touchstart" && event.type !== "touchend") event.preventDefault();
      event.stopImmediatePropagation();
    };
    const guarded = [
      ["wheel", { capture: true, passive: false }],
      ["touchmove", { capture: true, passive: false }],
      ["touchstart", { capture: true, passive: true }],
      ["touchend", { capture: true, passive: true }],
      ["keydown", { capture: true }],
      ["click", { capture: true }],
    ];
    for (const [type, options] of guarded) window.addEventListener(type, block, options);

    // Both fades end in the loader's own animation: then it leaves for good.
    loader.addEventListener("animationend", (event) => {
      if (event.target !== loader) return;
      loader.remove();
      delete root.dataset.siteLoader;
      for (const [type, options] of guarded) window.removeEventListener(type, block, options);
    });

    let revealed = false;
    const reveal = () => {
      if (revealed) return;
      revealed = true;
      root.dataset.siteLoader = "revealing";
      loader.setAttribute("data-leaving", "");
    };

    // The cap, from navigation start: `--site-loader-cap` (also the CSS fallback's delay).
    const cap = getComputedStyle(loader).getPropertyValue("--site-loader-cap").trim();
    const capMs = cap.endsWith("ms") ? parseFloat(cap) : parseFloat(cap) * 1000;
    setTimeout(reveal, Math.max(0, capMs - performance.now()));

    const percent = loader.querySelector("[data-loader-percent]");
    const sizes = JSON.parse(loader.dataset.bytes || "{}");
    let loaded = 0;
    let total = 0;
    const showProgress = () => {
      const share = total > 0 ? Math.min(1, loaded / total) : 0;
      loader.style.setProperty("--site-loader-progress", String(share));
      if (percent) percent.textContent = `${Math.floor(share * 100)}%`;
    };

    // Download one picture, counting its bytes as they arrive, then hand it
    // to its <img> and decode it. A failed download leaves the <img> to load
    // the URL itself; its share is counted once it settles either way.
    const load = async (image, priority) => {
      const url = image.dataset.src;
      const size = sizes[url] || 0;
      let counted = 0;
      const count = (bytes) => {
        const add = Math.min(bytes, size - counted);
        if (add <= 0) return;
        counted += add;
        loaded += add;
        showProgress();
      };
      try {
        const response = await fetch(url, { priority });
        if (!response.ok || !response.body) throw new Error(`${url}: ${response.status}`);
        const reader = response.body.getReader();
        const chunks = [];
        for (let chunk = await reader.read(); !chunk.done; chunk = await reader.read()) {
          chunks.push(chunk.value);
          count(chunk.value.byteLength);
        }
        image.src = URL.createObjectURL(new Blob(chunks, { type: response.headers.get("content-type") || "" }));
      } catch {
        image.src = url;
      }
      await image.decode().catch(() => undefined);
      count(size);
    };

    // The backdrop and her current face first, then the other faces.
    // Module scripts (the scene's time-of-day swap of data-src) have run by
    // DOMContentLoaded, so the URLs read then are the ones that will show.
    const track = async () => {
      const images = [...document.querySelectorAll("img[data-first-screen][data-src]")];
      total = images.reduce((sum, image) => sum + (sizes[image.dataset.src] || 0), 0);
      const first = images.filter((image) => image.hasAttribute("data-scene-backdrop") || image.dataset.layer === "current");
      await Promise.all(first.map((image) => load(image, "high")));
      await Promise.all(images.filter((image) => !first.includes(image)).map((image) => load(image, "auto")));
      reveal();
    };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", () => void track(), { once: true });
    else void track();
  })();
</script>
