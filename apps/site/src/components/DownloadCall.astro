---
import { GithubLogoIcon } from "@phosphor-icons/react";
import { cx, ghostButtonClass } from "@yinfengwindy/shiori-sdk";
import { primaryButtonClass } from "../../../desktop/renderer/src/shared/styles";
import { appIconImage } from "../lib/siteAssets";
import { DOWNLOAD_HEADLINE, SITE_LINKS, SITE_NAME, SITE_SLOGAN } from "../lib/siteMeta";
import DownloadButton from "./DownloadButton.astro";

/**
 * The calls to action closing the narrative (#771): the app icon as the page
 * title, 吟风's closing headline with its tagline, and the download / GitHub buttons, straight on the
 * scene — no panel. The download button's direct link comes from
 * DownloadButton.astro, shared with the top bar.
 */
// Button labels share the slogan's story type (.site-story-type in site.css).
const ctaLayoutClass = "site-story-type inline-flex items-center gap-2 text-body-lg";
---

<div class="site-download-body">
  <h1>
    <img
      src={appIconImage.src}
      width={appIconImage.width}
      height={appIconImage.height}
      alt={SITE_NAME}
      loading="lazy"
      decoding="async"
      class="site-download-icon"
    />
  </h1>
  <div class="site-download-heading">
    <p class="site-download-slogan site-story-type">{DOWNLOAD_HEADLINE}</p>
    <p class="site-download-tagline site-story-type text-title">{SITE_SLOGAN}</p>
  </div>
  <div class="flex flex-wrap justify-center gap-3">
    <DownloadButton class={cx(primaryButtonClass, ctaLayoutClass)} iconSize={20} />
    <a href={SITE_LINKS.github} class={cx(ghostButtonClass, ctaLayoutClass)}>
      <GithubLogoIcon size={20} aria-hidden="true" />
      GitHub
    </a>
  </div>
</div>
