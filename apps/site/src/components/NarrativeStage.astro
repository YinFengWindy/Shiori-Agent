---
import { CaretDownIcon } from "@phosphor-icons/react";
import { mascotExpressions } from "../../../desktop/renderer/src/shared/mascot/mascotExpressions";
import { NARRATIVE_LINES } from "../content/narrative";
import { siteText } from "../i18n";
import type { Locale } from "../i18n/locales";
import { narrativeCgs, narrativeExpressionSprites } from "../lib/siteAssets";
import DownloadCall from "./DownloadCall.astro";
import SceneBackdrop from "./SceneBackdrop.astro";

/**
 * The scroll-driven galgame narrative at the top of the home page (#771):
 * a sticky one-viewport stage (scene, 吟风's expression stack, an event CG
 * frame, the dialogue box, and the download call it ends on) inside a
 * section one viewport tall per step, with one scroll-snap point per step:
 * one per line, then the download state, where 吟风, the CG and the dialogue
 * fade out and the download call fades in over the same scene. Keyboard,
 * touch and the scrollbar snap natively; the script below steps the wheel
 * one step per gesture, advances a step on a click or tap on the stage, and
 * maps the scroll position to the step on show (lib/narrativeModel.ts).
 * Every line is static text in reading order; the ones off stage are
 * visually hidden, not removed. Under reduced motion, or without scripting,
 * site.css lays the lines out as a plain list with the download call below.
 *
 * Each line has a stable anchor (content/narrative.ts, #806): an address
 * naming a line or the download call (`/#remembers`, `/#download`) opens the
 * narrative on that step, which is how the language switch keeps the
 * reader's place. A line's anchor is the `id` of its step's snap point, not
 * of its text: the snap point sits in the page flow exactly at the step, so
 * the browser's own jump lands there, where a jump to text on the pinned
 * stage would chase it towards the narrative's end. The line names its
 * anchor in `data-anchor`; under reduced motion, where the lines are a
 * plain list and the snap points are gone, the script jumps to the line.
 */
interface Props {
  /** The page's language: the lines', the name plate's and the CGs' alt text. */
  locale: Locale;
  /** `id` of the download call (hash links, focus). */
  downloadId: string;
}

const { locale, downloadId } = Astro.props;
const text = siteText(locale);
const [firstLine] = NARRATIVE_LINES;
if (!firstLine) throw new Error("the narrative needs at least one line");
// One step per line, then the download state.
const stepCount = NARRATIVE_LINES.length + 1;
const usedCgKeys = [...new Set(NARRATIVE_LINES.flatMap((line) => (line.cg ? [line.cg] : [])))];
---

<section
  class="site-narrative relative"
  style={`--site-narrative-steps: ${stepCount}`}
  data-narrative
>
  <div class="site-narrative-stage" data-narrative-stage>
    <SceneBackdrop firstScreen />
    <div class="site-narrative-figure mascot-stack" aria-hidden="true">
      {/* The home page loader downloads every sprite itself, from data-src (SiteLoader.astro). */}
      {
        mascotExpressions.map((expression) => {
          const sprite = narrativeExpressionSprites[expression];
          const first = expression === firstLine.expression;
          return (
            <img
              data-src={sprite.src}
              width={sprite.width}
              height={sprite.height}
              alt=""
              draggable="false"
              decoding="async"
              class="mascot-layer"
              data-expression={expression}
              data-layer={first ? "current" : "hidden"}
              data-first-screen
            />
          );
        })
      }
      <noscript>
        <img
          src={narrativeExpressionSprites[firstLine.expression].src}
          width={narrativeExpressionSprites[firstLine.expression].width}
          height={narrativeExpressionSprites[firstLine.expression].height}
          alt=""
          decoding="async"
          class="mascot-layer"
        />
      </noscript>
    </div>
    <div class="site-narrative-cgs" aria-hidden="true">
      {/* No src but the first line's: the script below fetches each CG as its line draws near. */}
      {
        usedCgKeys.map((key) => {
          const cg = narrativeCgs[key];
          return (
            <img
              src={firstLine.cg === key ? cg.src : undefined}
              data-src={cg.src}
              width={cg.width}
              height={cg.height}
              alt={text.art[key]}
              decoding="async"
              class="site-narrative-cg"
              data-cg={key}
              data-active={firstLine.cg === key ? "" : undefined}
            />
          );
        })
      }
    </div>
    <div class="site-dialogue">
      <p class="site-dialogue-name site-story-type">{text.narrative.speaker}</p>
      <div class="site-dialogue-lines">
        {
          NARRATIVE_LINES.map((line, index) => (
            <p
              class="site-narrative-line site-story-type"
              data-narrative-line
              data-anchor={line.id}
              data-expression={line.expression}
              data-cg={line.cg}
              data-active={index === 0 ? "" : undefined}
            >
              {text.narrative.lines[line.id]}
            </p>
          ))
        }
      </div>
      <CaretDownIcon size={20} weight="bold" aria-hidden="true" className="site-dialogue-caret" />
    </div>
    <div id={downloadId} class="site-download" data-narrative-download>
      <DownloadCall locale={locale} />
    </div>
  </div>
  <div class="site-narrative-snaps" aria-hidden="true">
    {/* Each line's anchor; the download step's is the download call's own id. */}
    {Array.from({ length: stepCount }, (_, step) => (
      <div class="site-narrative-snap" id={NARRATIVE_LINES[step]?.id} />
    ))}
  </div>
</section>

<script>
  import {
    createWheelGestureGate,
    narrativeCgsToLoad,
    narrativeClickTarget,
    narrativeAnchorStep,
    narrativeFinalOffset,
    narrativeStepAt,
    narrativeStepOffset,
    narrativeStepTarget,
  } from "../lib/narrativeModel";

  function required<T>(element: T | null, name: string): T {
    if (!element) throw new Error(`narrative ${name} is missing`);
    return element;
  }

  const section = required(document.querySelector<HTMLElement>("[data-narrative]"), "section");
  const stage = required(section.querySelector<HTMLElement>("[data-narrative-stage]"), "stage");
  const lines = [...section.querySelectorAll<HTMLElement>("[data-narrative-line]")];
  const sprites = [...section.querySelectorAll<HTMLImageElement>("img[data-expression]")];
  const cgs = [...section.querySelectorAll<HTMLImageElement>("img[data-cg]")];
  const lineCgs = lines.map((line) => line.dataset.cg);
  // Reduced motion keeps the static list layout (site.css): nothing to drive.
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  let shownIndex = 0;
  let shownExpression = lines[0]?.dataset.expression;

  /** Put line `index` on stage: its text, 吟风's face (fading over the last one) and its CG. */
  function show(index: number) {
    if (index === shownIndex) return;
    lines[shownIndex]?.removeAttribute("data-active");
    const line = lines[index];
    if (!line) throw new Error(`no narrative line ${index}`);
    line.setAttribute("data-active", "");
    const expression = line.dataset.expression;
    if (expression !== shownExpression) {
      for (const sprite of sprites) {
        const key = sprite.dataset.expression;
        sprite.dataset.layer = key === expression ? "current" : key === shownExpression ? "previous" : "hidden";
      }
      shownExpression = expression;
    }
    for (const cg of cgs) cg.toggleAttribute("data-active", cg.dataset.cg === line.dataset.cg);
    shownIndex = index;
  }

  /**
   * Fetch the CGs of the line on stage at `step` and of the next few
   * (lib/narrativeModel.ts): the CGs carry no src (but the first line's)
   * until their line draws near, so a reader who stops early, or a slow
   * line, never spends bandwidth on the rest.
   */
  function loadCgsNear(step: number) {
    const wanted = new Set(narrativeCgsToLoad(lineCgs, step));
    for (const cg of cgs) {
      const { cg: key, src } = cg.dataset;
      if (key && src && wanted.has(key) && !cg.getAttribute("src")) cg.src = src;
    }
  }

  function currentScroll() {
    return {
      offset: -section.getBoundingClientRect().top,
      viewportHeight: stage.clientHeight,
      lineCount: lines.length,
    };
  }

  /**
   * Put step `step` on stage: a line, or — one step past the last line — the
   * download state, which fades the cast out over the last line (kept
   * underneath, so stepping back fades it straight in again).
   */
  function showStep(step: number) {
    loadCgsNear(step);
    show(Math.min(step, lines.length - 1));
    stage.toggleAttribute("data-final", step === lines.length);
  }

  let frame = 0;
  function update() {
    frame = 0;
    if (reducedMotion.matches) {
      stage.removeAttribute("data-final");
      return;
    }
    showStep(narrativeStepAt(currentScroll()));
  }
  function scheduleUpdate() {
    frame ||= requestAnimationFrame(update);
  }

  // Wheel: one smooth step per gesture (see narrativeModel.ts for why the
  // wheel cannot be left to CSS snapping). While a step is still scrolling,
  // the next one starts from its target, so quick notches never drop a line.
  const PENDING_STEP_MS = 800;
  const wheelStartsGesture = createWheelGestureGate();
  let pendingStep: { offset: number; at: number } | null = null;

  /** Where a step from now should start: the in-flight step's target, if any. */
  function stepOrigin(now: number) {
    const scroll = currentScroll();
    const pending = pendingStep && now - pendingStep.at < PENDING_STEP_MS ? pendingStep : null;
    return { scroll, from: pending ? { ...scroll, offset: pending.offset } : scroll };
  }

  /** Smooth-scroll to `target` (a narrative offset) and remember it as the in-flight step. */
  function stepTo(target: number, scrollOffset: number, now: number) {
    pendingStep = { offset: target, at: now };
    window.scrollTo({ top: window.scrollY + target - scrollOffset, behavior: "smooth" });
  }

  function onWheel(event: WheelEvent) {
    if (reducedMotion.matches || event.ctrlKey || event.deltaY === 0 || Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;
    const { scroll, from } = stepOrigin(event.timeStamp);
    const target = narrativeStepTarget(from, event.deltaY > 0 ? 1 : -1);
    const startsGesture = wheelStartsGesture(event.timeStamp);
    if (target === null) return;
    event.preventDefault();
    if (!startsGesture) return;
    stepTo(target, scroll.offset, event.timeStamp);
  }

  // Click / tap anywhere on the stage advances one step, as in a galgame;
  // the download buttons and other controls keep their own action. Taps never fire
  // after a swipe, so this does not double-step with the touch handler.
  function onStageClick(event: MouseEvent) {
    if (reducedMotion.matches || event.button !== 0) return;
    if (event.target instanceof Element && event.target.closest("a, button")) return;
    const { scroll, from } = stepOrigin(event.timeStamp);
    const target = narrativeClickTarget(from);
    if (target === null) return;
    stepTo(target, scroll.offset, event.timeStamp);
  }

  // Touch scrolls natively, but a swipe shorter than half the screen without
  // much fling would snap back to the same line: once the finger lifts, a
  // swipe of at least SWIPE_MIN_PX settles one line on from where it began.
  // Passive — the swipe itself is never blocked.
  const SWIPE_MIN_PX = 32;
  let touchStart: { y: number; offset: number } | null = null;

  function onTouchStart(event: TouchEvent) {
    const touch = event.touches.length === 1 ? event.touches[0] : undefined;
    touchStart = touch && !reducedMotion.matches ? { y: touch.clientY, offset: currentScroll().offset } : null;
  }

  function onTouchEnd(event: TouchEvent) {
    const start = touchStart;
    touchStart = null;
    const touch = event.changedTouches[0];
    if (!start || !touch) return;
    const swipe = start.y - touch.clientY;
    if (Math.abs(swipe) < SWIPE_MIN_PX) return;
    const scroll = currentScroll();
    const target = narrativeStepTarget({ ...scroll, offset: start.offset }, swipe > 0 ? 1 : -1);
    if (target === null) return;
    window.scrollTo({ top: window.scrollY + target - scroll.offset, behavior: "smooth" });
  }

  window.addEventListener("scroll", scheduleUpdate, { passive: true });
  window.addEventListener("wheel", onWheel, { passive: false });
  stage.addEventListener("click", onStageClick);
  window.addEventListener("touchstart", onTouchStart, { passive: true });
  window.addEventListener("touchend", onTouchEnd, { passive: true });
  window.addEventListener(
    "touchcancel",
    () => {
      touchStart = null;
    },
    { passive: true },
  );
  window.addEventListener("resize", scheduleUpdate);
  reducedMotion.addEventListener("change", scheduleUpdate);

  // The download call sits inside the pinned stage, so neither its #hash
  // nor keyboard focus would bring it on screen by themselves: both go to
  // the download state.
  const download = required(stage.querySelector<HTMLElement>("[data-narrative-download]"), "download call");
  function downloadOffsetFromHere() {
    const scroll = currentScroll();
    return { scroll, target: narrativeFinalOffset(scroll) };
  }
  download.addEventListener("focusin", (event) => {
    const { scroll, target } = downloadOffsetFromHere();
    const distance = Math.abs(scroll.offset - target);
    if (reducedMotion.matches || distance < 1) return;
    // One step away: the usual smooth step. From further back, jump rather
    // than scroll every remaining line past the reader.
    if (distance <= scroll.viewportHeight) stepTo(target, scroll.offset, event.timeStamp);
    else window.scrollTo({ top: window.scrollY + target - scroll.offset, behavior: "instant" });
  });
  // In-page links to the download call (the top bar's icon and name, #797)
  // glide to the download state instead of the browser's jump to the pinned
  // call. Under reduced motion the call sits in the page flow and the
  // browser's own jump lands on it.
  document.addEventListener("click", (event) => {
    if (reducedMotion.matches || event.defaultPrevented || event.button !== 0) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.target instanceof Element ? event.target.closest("a[href]") : null;
    if (!(link instanceof HTMLAnchorElement) || link.hash !== `#${download.id}`) return;
    if (link.origin !== window.location.origin || link.pathname !== window.location.pathname || link.search !== window.location.search) return;
    event.preventDefault();
    const { scroll, target } = downloadOffsetFromHere();
    window.scrollTo({ top: window.scrollY + target - scroll.offset, behavior: "smooth" });
  });
  // An address naming a line or the download call (the language switch's,
  // the top bar's from another page) opens the narrative on that step. A
  // line's anchor is its snap point, where the browser's own jump lands; the
  // download call's is the call itself, on the pinned stage, which the
  // browser cannot bring on screen, so the step is scrolled to here. Under
  // reduced motion the lines and the call sit in the page flow and the snap
  // points are gone: the browser jumps to the call itself, and here to a line.
  const anchoredStep = narrativeAnchorStep(window.location.hash, {
    lineIds: lines.map((line) => required(line.dataset.anchor ?? null, "line anchor")),
    downloadId: download.id,
  });
  if (anchoredStep !== null) {
    if (!reducedMotion.matches) {
      const scroll = currentScroll();
      window.scrollTo({ top: window.scrollY + narrativeStepOffset(anchoredStep, scroll) - scroll.offset });
    } else {
      lines[anchoredStep]?.scrollIntoView({ block: "center" });
    }
  }

  // A reload or a #hash link can open the page mid-narrative.
  update();
</script>
