---
import type { Locale } from "../i18n/locales";
import LanguageSwitch from "./LanguageSwitch.astro";

/**
 * The home page's language switch (#806): the corner button beside the
 * music switch (the top bar carries its own), and the script that keeps
 * every switch on the page — the corner's, the top bar's, the English
 * prompt's — pointing at the reader's place: the line on show, the download
 * call, or the showcase block being read, as an anchor on the other
 * language's home page (`/en/#remembers`). That page opens there and skips
 * its loader, as any anchored visit does (lib/siteLoaderGate.ts). Without
 * scripting the switches lead to the other home page's top.
 */
interface Props {
  locale: Locale;
  /** The other language's home page. */
  href: string;
}

const { locale, href } = Astro.props;
---

<LanguageSwitch locale={locale} href={href} variant="corner" />

<script>
  import { anchorAtReadingLine, hrefWithAnchor } from "../lib/languageSwitch";
  import { narrativeStepAnchor, narrativeStepAt } from "../lib/narrativeModel";
  import { isPastNarrative } from "../lib/siteHeader";

  function required<T>(element: T | null, name: string): T {
    if (!element) throw new Error(`the language switch reads the ${name}, which is missing`);
    return element;
  }

  const section = required(document.querySelector<HTMLElement>("[data-narrative]"), "narrative");
  const stage = required(section.querySelector<HTMLElement>("[data-narrative-stage]"), "narrative stage");
  const download = required(section.querySelector<HTMLElement>("[data-narrative-download]"), "download call");
  const lines = [...section.querySelectorAll<HTMLElement>("[data-narrative-line]")];
  const features = [...document.querySelectorAll<HTMLElement>(".site-feature")];
  // The lines' anchors are named on them (their snap points carry the ids).
  const lineIds = lines.map((line) => required(line.dataset.anchor ?? null, "line anchor"));
  const anchors = { lineIds, downloadId: download.id };
  // Each switch's static target, the place to be added to it.
  const switches = [...document.querySelectorAll<HTMLAnchorElement>("a[data-lang-switch]")].map((link) => ({
    link,
    base: required(link.getAttribute("href"), "switch's href"),
  }));
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  /** Where each element is, under its anchor (`ids`, its own id by default). */
  const places = (elements: readonly HTMLElement[], ids = elements.map((element) => element.id)) =>
    elements.map((element, index) => ({ id: ids[index] ?? element.id, top: element.getBoundingClientRect().top }));

  /** The anchor of where the reader is. */
  function readerAnchor(): string {
    const viewportHeight = window.innerHeight;
    // A block is being read once its top has risen to the middle of the screen.
    const readingLine = viewportHeight / 2;
    // Reduced motion: the lines and the download call sit in the page flow.
    if (reducedMotion.matches) {
      return anchorAtReadingLine([...places(lines, lineIds), ...places([download, ...features])], readingLine);
    }
    if (features.length > 0 && isPastNarrative(section.getBoundingClientRect().bottom, viewportHeight)) {
      return anchorAtReadingLine(places(features), readingLine);
    }
    const step = narrativeStepAt({
      offset: -section.getBoundingClientRect().top,
      viewportHeight: stage.clientHeight,
      lineCount: lines.length,
    });
    return narrativeStepAnchor(step, anchors);
  }

  let frame = 0;
  function update() {
    frame = 0;
    const anchor = readerAnchor();
    for (const { link, base } of switches) link.href = hrefWithAnchor(base, anchor);
  }
  const scheduleUpdate = () => {
    frame ||= requestAnimationFrame(update);
  };
  window.addEventListener("scroll", scheduleUpdate, { passive: true });
  window.addEventListener("resize", scheduleUpdate);
  reducedMotion.addEventListener("change", scheduleUpdate);
  update();
</script>
