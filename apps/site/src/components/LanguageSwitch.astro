---
import { cx } from "@yinfengwindy/shiori-sdk";
import { siteText } from "../i18n";
import { LOCALE_INFO, type Locale, otherLocale } from "../i18n/locales";
import { controlButtonClass } from "../lib/controlButton";
import "../styles/language.css";

/**
 * The link to the other language (#806): 「EN」 on a Chinese page, 「中」 on
 * an English one, named in full for assistive technology. A plain link to
 * the same page in the other language (`languageSwitchHref`), so it works
 * without scripting; on the home page HomeLanguageSwitch.astro adds the
 * reader's place to it as they go.
 *
 * Both variants wear the music switch's look (`controlButtonClass`, #810).
 * `corner`: the home page's button in the corner controls, beside the music
 * switch (HomePage.astro), which hide without scripting (site.css). `bar`: inside the top
 * bar, where it takes over once the bar slides in (header.css).
 */
interface Props {
  /** The page's language (the switch leads to the other one). */
  locale: Locale;
  /** The same page in the other language. */
  href: string;
  variant: "corner" | "bar";
}

const { locale, href, variant } = Astro.props;
const text = siteText(locale).languageSwitch;
const className = cx(controlButtonClass, variant === "corner" && "site-lang-corner");
---

<a
  href={href}
  hreflang={LOCALE_INFO[otherLocale(locale)].hreflang}
  class={className}
  aria-label={text.label}
  title={text.label}
  data-lang-switch>{text.text}</a
>
