---
import BlogPostPage from "../../components/BlogPostPage.astro";
import type { PageVersions } from "../../i18n/locales";
import { required } from "../../lib/dom";
import { type BlogPost, getPublishedPosts, postVersionsBySlug } from "../../lib/blog";

/** A blog post in Chinese, `/blog/<slug>/` (components/BlogPostPage.astro). */
export async function getStaticPaths() {
  const versions = await postVersionsBySlug();
  const posts = await getPublishedPosts("zh");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, versions: required(versions.get(post.id), `the versions of post ${post.id}`) } }));
}

interface Props {
  post: BlogPost;
  versions: PageVersions;
}

const { post, versions } = Astro.props;
---

<BlogPostPage locale="zh" post={post} versions={versions} />
