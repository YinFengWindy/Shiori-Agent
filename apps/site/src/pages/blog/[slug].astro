---
import { render } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SectionIndex from "../../components/SectionIndex.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import {
  BLOG_AUTHOR,
  BLOG_TITLE,
  type BlogPost,
  blogPostPath,
  formatPostDate,
  getPublishedPosts,
  isoPostDate,
} from "../../lib/blog";
import { inlineJson } from "../../lib/breadcrumbs";
import { postTableOfContents } from "../../lib/sectionIndex";
import { appIconImage } from "../../lib/siteAssets";
import { SITE_NAME } from "../../lib/siteMeta";
import "../../styles/reading.css";
import "../../styles/blog.css";

/**
 * One blog post (#773): title, day and byline, the cover if it has one, then
 * the post on a light reading column over the app's wash. The head carries
 * the post's own description, `og:type` article with its publication time,
 * and BlogPosting structured data with 吟风 as the author.
 *
 * Over the title, the breadcrumb 首页 / 博客 / the post is the way back
 * (#797): its 博客 step is the 「返回博客」 link, so there is no second
 * one. A post with two or more sections gets a table of contents from its
 * rendered headings (their ids are the anchors): beside the column on wide
 * screens, folded under the title on narrow ones (SectionIndex.astro).
 */
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, date, cover } = post.data;
const { Content, headings } = await render(post);
const tableOfContents = postTableOfContents(headings);
const postPath = blogPostPath(post);
if (!Astro.site) throw new Error("astro.config.ts must set `site`: the post's structured data is built from it");
const postUrl = new URL(postPath, Astro.site).href;
const published = isoPostDate(date);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: published,
  inLanguage: "zh-CN",
  url: postUrl,
  mainEntityOfPage: postUrl,
  author: { "@type": "Person", name: BLOG_AUTHOR },
  publisher: {
    "@type": "Organization",
    name: SITE_NAME,
    logo: { "@type": "ImageObject", url: new URL(appIconImage.src, Astro.site).href },
  },
  ...(cover ? { image: new URL(cover.image.src, Astro.site).href } : {}),
};
const structuredDataJson = inlineJson(structuredData);
---

<SiteLayout title={`${title} · ${SITE_NAME}`} description={description} ogType="article">
  <Fragment slot="meta">
    <meta property="article:published_time" content={published} />
    <meta property="article:author" content={BLOG_AUTHOR} />
    <script type="application/ld+json" set:html={structuredDataJson} />
  </Fragment>
  <SiteHeader mode="fixed" current="blog" />
  <main class="site-reading">
    <div class="site-section-layout">
      <article class="site-reading-column site-section-layout-main">
        <header class="site-post-head">
          <Breadcrumbs
            trail={[
              { label: BLOG_TITLE, href: "/blog/" },
              { label: title, href: postPath },
            ]}
          />
          <h1 class="site-reading-title site-story-type">{title}</h1>
          <p class="site-reading-meta">
            <time datetime={published}>{formatPostDate(date)}</time>
            <span aria-hidden="true">·</span>
            <span>{BLOG_AUTHOR}</span>
          </p>
        </header>
        {tableOfContents.length > 0 && <SectionIndex variant="inline" title="目录" entries={tableOfContents} />}
        {
          cover && (
            <img
              src={cover.image.src}
              width={cover.image.width}
              height={cover.image.height}
              alt={cover.alt}
              decoding="async"
              class="site-post-cover"
            />
          )
        }
        <div class="site-prose">
          <Content />
        </div>
      </article>
      {tableOfContents.length > 0 && <SectionIndex variant="aside" title="目录" entries={tableOfContents} />}
    </div>
  </main>
  <SiteFooter />
</SiteLayout>
