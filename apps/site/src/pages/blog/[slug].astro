---
import BlogPostPage from "../../components/BlogPostPage.astro";
import { type PostPageProps, postStaticPaths } from "../../lib/blog";

/** A blog post in Chinese, `/blog/<slug>/` (components/BlogPostPage.astro). */
export function getStaticPaths() {
  return postStaticPaths("zh");
}

type Props = PostPageProps;

const { post, versions } = Astro.props;
---

<BlogPostPage locale="zh" post={post} versions={versions} />
