---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import {
  BLOG_DESCRIPTION,
  BLOG_EMPTY_LINE,
  BLOG_TITLE,
  blogPostPath,
  formatPostDate,
  getPublishedPosts,
  isoPostDate,
} from "../../lib/blog";
import { latestDate } from "../../lib/pageUpdated";
import { pageTitle } from "../../i18n";
import { type PageVersions, languageSwitchHref } from "../../i18n/locales";
import { SITE_SECTIONS } from "../../lib/siteMeta";
import "../../styles/reading.css";
import "../../styles/blog.css";

/**
 * The blog's list page (#773): one card per published post, newest first —
 * its cover if it has one, title, day and summary, the whole card one link.
 * The breadcrumb over the heading leads back home (#797). Dated by the
 * newest post (#799). Chinese only until the English blog (#807): the
 * language switch leads to the English home page meanwhile.
 */
const versions: PageVersions = SITE_SECTIONS.blog;
const languageHref = languageSwitchHref("zh", versions);
const posts = await getPublishedPosts();
const updated = latestDate(posts.map((post) => post.data.date));
---

<SiteLayout locale="zh" versions={versions} title={pageTitle(BLOG_TITLE, "zh")} description={BLOG_DESCRIPTION} updated={updated}>
  <SiteHeader locale="zh" mode="fixed" current="blog" languageHref={languageHref} />
  <main class="site-reading">
    <div class="site-blog-shelf">
      <Breadcrumbs locale="zh" trail={[{ label: BLOG_TITLE, href: SITE_SECTIONS.blog.zh }]} />
      <h1 class="site-reading-heading site-story-type">{BLOG_TITLE}</h1>
      {
        posts.length === 0 ? (
          <p class="site-blog-empty site-story-type">{BLOG_EMPTY_LINE}</p>
        ) : (
          <ul class="site-blog-list">
            {posts.map((post) => (
              <li>
                <article class="site-post-card">
                  {post.data.cover && (
                    <img
                      src={post.data.cover.image.src}
                      width={post.data.cover.image.width}
                      height={post.data.cover.image.height}
                      alt={post.data.cover.alt}
                      loading="lazy"
                      decoding="async"
                      class="site-post-card-cover"
                    />
                  )}
                  <div class="site-post-card-text">
                    <h2 class="site-post-card-title">
                      <a href={blogPostPath(post)} class="site-post-card-link">
                        {post.data.title}
                      </a>
                    </h2>
                    <time class="site-post-card-date" datetime={isoPostDate(post.data.date)}>
                      {formatPostDate(post.data.date)}
                    </time>
                    <p class="site-post-card-summary">{post.data.description}</p>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </main>
  <SiteFooter locale="zh" />
</SiteLayout>
