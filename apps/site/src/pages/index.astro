---
import NarrativeStage from "../components/NarrativeStage.astro";
import SiteLoader from "../components/SiteLoader.astro";
import { SoundToggle } from "../components/SoundToggle";
import SiteLayout from "../layouts/SiteLayout.astro";
import { SITE_NAME, SITE_SLOGAN } from "../lib/siteMeta";

/*
 * Home page (#768): the loader over the first screen (#770), the
 * scroll-driven narrative (#771), which ends on the
 * download call over the same scene, then everything after it in one
 * free-scrolling block — the product showcase (#772) and the blog entry
 * (#773) go into `.site-after-narrative`, empty until then. The music
 * switch stays in the corner over all of it.
 */
---

<SiteLayout title={`${SITE_NAME} · ${SITE_SLOGAN}`}>
  <SiteLoader />
  <main>
    <NarrativeStage downloadId="download" />
    <div class="site-after-narrative"></div>
  </main>
  <SoundToggle client:idle className="site-sound-toggle" />
</SiteLayout>
