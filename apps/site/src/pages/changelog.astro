---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SectionIndex from "../components/SectionIndex.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { formatReleaseDate, loadChangelog } from "../lib/changelog";
import { SITE_LINKS, pageTitle } from "../lib/siteMeta";
import "../styles/reading.css";
import "../styles/changelog.css";

/**
 * The changelog (#792): every published GitHub release, newest first — the
 * version, its day, a link to the release on GitHub and its notes — on the
 * blog's reading columns. Built from the GitHub API at build time
 * (`lib/changelog.ts`); a release published later reaches the page through
 * the redeploy workflow (.github/workflows/site-redeploy-on-release.yml).
 * A breadcrumb leads back home and an index of the versions (each with its
 * day) jumps to any of them (#797): beside the list on wide screens, folded
 * under the heading on narrow ones (SectionIndex.astro). Dated by the
 * newest release (#799).
 */
const CHANGELOG_TITLE = "更新日志";
const CHANGELOG_DESCRIPTION =
  "Shiori 每个版本的新增、改进与修复都记在这里。这个开源免费的 Windows AI 伴侣与 Personal Agent 一直在长大：记忆、好感度、主动消息和聊天渠道的每一次变化，按版本从新到旧排好，也能直接下载最新版。";
const entries = await loadChangelog();
const [newest] = entries;
const versionIndex = entries.map((entry) => ({
  id: entry.version,
  label: entry.version,
  level: 0 as const,
  note: formatReleaseDate(entry.publishedAt),
}));
---

<SiteLayout title={pageTitle(CHANGELOG_TITLE)} description={CHANGELOG_DESCRIPTION} updated={newest?.publishedAt}>
  <SiteHeader mode="fixed" current="changelog" />
  <main class="site-reading">
    <div class="site-section-layout">
      <div class="site-changelog site-section-layout-main">
        <header>
          <Breadcrumbs trail={[{ label: CHANGELOG_TITLE, href: SITE_LINKS.changelog }]} />
          <h1 class="site-reading-heading site-story-type">{CHANGELOG_TITLE}</h1>
        </header>
        <SectionIndex variant="inline" title="版本" entries={versionIndex} />
        {
          entries.map((entry) => (
            <article class="site-reading-column site-changelog-release" id={entry.version} aria-labelledby={`${entry.version}-title`}>
              <header class="site-changelog-head">
                <h2 class="site-reading-title site-story-type" id={`${entry.version}-title`}>
                  {entry.version}
                </h2>
                <p class="site-reading-meta">
                  <time datetime={entry.publishedAt.toISOString()}>{formatReleaseDate(entry.publishedAt)}</time>
                  <span aria-hidden="true">·</span>
                  <a href={entry.url} rel="noopener" class="site-changelog-source">
                    GitHub 上查看
                  </a>
                </p>
              </header>
              <div class="site-prose" set:html={entry.html} />
            </article>
          ))
        }
      </div>
      <SectionIndex variant="aside" title="版本" entries={versionIndex} />
    </div>
  </main>
  <SiteFooter />
</SiteLayout>
