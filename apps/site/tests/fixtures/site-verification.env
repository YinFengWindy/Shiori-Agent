# site:test's drafts-mode build (dist-drafts/) reads these as well, so the
# tests see the search engines' verification tags with tokens set
# (lib/siteVerification.ts); the production-mode build (dist/) runs without
# them and must carry none. Placeholder tokens, not real ones.
SITE_VERIFY_GOOGLE=test-google-token
SITE_VERIFY_BING=TEST-BING-TOKEN
SITE_VERIFY_BAIDU=codeva-test-baidu
