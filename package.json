{
  "name": "shiori",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron-winstaller",
      "uiohook-napi"
    ]
  },
  "scripts": {
    "start": "pnpm run desktop:start",
    "build": "pnpm run build:desktop",
    "build:desktop": "pnpm --filter shiori-desktop run build",
    "desktop:build": "pnpm run build:desktop",
    "desktop:dev": "pnpm --filter shiori-desktop run dev",
    "desktop:start": "pnpm --filter shiori-desktop run start:built",
    "desktop:test": "node desktop/scripts/test-unit.mjs",
    "desktop:typecheck": "pnpm --filter shiori-desktop run typecheck",
    "dev": "pnpm run desktop:dev",
    "lint": "eslint desktop/src desktop/renderer/src",
    "test": "pnpm run desktop:test",
    "typecheck": "pnpm --filter shiori-desktop run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.1"
  }
}
