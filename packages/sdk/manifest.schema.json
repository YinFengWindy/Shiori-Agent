{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YinFengWindy/Shiori-Agent/blob/main/packages/sdk/manifest.schema.json",
  "title": "Shiori plugin manifest (api: 4)",
  "description": "plugins/<id>/manifest.yaml 的现行格式。字段与取值以 apps/backend/agent/plugin_host/manifest.py 和 package_contract.py 为准。只接受 api: 4：其他值安装时被拒绝，已安装的在启动时 BLOCKED（unsupported_api）。sdk 是最低 SDK 约束，不满足时 BLOCKED（incompatible_sdk）。frontend 是唯一前端入口；编译产物携带 exports、css、peers。schema 只描述字段形状；跨字段规则（渠道名与会话类型不重复、前缀互不包含、dependencies 与 optional_dependencies、inject 与 optional_inject 不重叠、入口文件存在且可解析、contributes.channels 要求 inject 含 channels、sdk 比较符语法）仍由解析代码判定。",
  "type": "object",
  "additionalProperties": false,
  "required": ["api", "sdk"],
  "properties": {
    "api": {
      "description": "插件 API 版本，只接受整数 4。",
      "type": "integer",
      "const": 4
    },
    "sdk": {
      "description": "最低 SDK 版本约束。空格分隔的 =、>、>=、<、<= 比较，逻辑与。基线为 >=4.0.0。",
      "type": "string",
      "minLength": 1
    },
    "id": {
      "description": "插件 ID，与插件目录名一致。",
      "$ref": "#/$defs/portableName"
    },
    "display_name": { "$ref": "#/$defs/nonEmptyString" },
    "version": {
      "description": "插件自身版本（SemVer），与 pyproject.toml 一致。",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "desc": { "type": "string" },
    "author": { "type": "string" },
    "distribution": {
      "description": "builtin 随宿主加载；external 只在安装到工作区后加载。",
      "enum": ["builtin", "external"],
      "default": "builtin"
    },
    "category": {
      "description": "插件管理页分组。省略时声明了渠道即 channel，否则 feature。",
      "enum": ["feature", "channel", "system"]
    },
    "default_enabled": { "type": "boolean", "default": true },
    "supports_hot_unload": { "type": "boolean", "default": true },
    "entry": {
      "description": "后端入口，相对插件目录。",
      "type": "string",
      "default": "backend/plugin.py"
    },
    "config_model": {
      "description": "配置模型，形如 \"模块:类名\"，模块相对 backend/。",
      "type": "string"
    },
    "dependencies": { "$ref": "#/$defs/pluginIds" },
    "optional_dependencies": { "$ref": "#/$defs/pluginIds" },
    "inject": {
      "description": "setup 里经 ctx.require 取用的服务 Key 名称；缺少提供方时插件 BLOCKED。",
      "$ref": "#/$defs/keyNames"
    },
    "optional_inject": {
      "description": "setup 里经 ctx.get 取用的服务 Key 名称；没有提供方时得到 None。不能与 inject 重叠。",
      "$ref": "#/$defs/keyNames"
    },
    "provides": {
      "description": "插件经 ctx.provide 发布的服务 Key 名称。",
      "$ref": "#/$defs/keyNames"
    },
    "contributes": {
      "description": "静态贡献。渠道声明写在 contributes.channels，并且 inject 含 channels。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channels": {
          "type": "array",
          "items": { "$ref": "#/$defs/channel" }
        }
      }
    },
    "frontend": {
      "description": "唯一前端入口；源码只声明 entry，编译产物还包含 exports、css 和 peers。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "css": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "exports": {
          "type": "array",
          "items": {
            "enum": [
              "ui",
              "background",
              "surface"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "peers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "react",
            "react-dom",
            "@yinfengwindy/shiori-sdk"
          ],
          "properties": {
            "react": {
              "type": "string"
            },
            "react-dom": {
              "type": "string"
            },
            "@yinfengwindy/shiori-sdk": {
              "type": "string"
            }
          }
        }
      }
    },
    "assets": {
      "description": "外部包随附的静态文件，相对插件目录。",
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["contributes"],
        "properties": {
          "contributes": {
            "required": ["channels"],
            "properties": { "channels": { "minItems": 1 } }
          }
        }
      },
      "then": {
        "properties": { "inject": { "contains": { "const": "channels" } } }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "portableName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "pluginIds": {
      "description": "插件 ID 列表。",
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "keyNames": {
      "description": "服务 Key 名称列表（shiori_sdk.kernel.Key.name）：非空、无首尾空白；不论 api 版本，都不能以 host. 开头（宿主保留前缀）。",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\S(.*\\S)?$",
        "not": { "pattern": "^host\\." }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "chat_types"],
      "properties": {
        "name": {
          "description": "渠道基础名；desktop 为宿主保留。",
          "allOf": [
            { "$ref": "#/$defs/portableName" },
            { "not": { "const": "desktop" } }
          ]
        },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "contact_label": { "$ref": "#/$defs/nonEmptyString" },
        "instance_prefix": {
          "description": "账号实例名前缀，必须以 \"<name>_\" 开头。",
          "$ref": "#/$defs/nonEmptyString"
        },
        "group_listening": { "type": "boolean", "default": false },
        "chat_types": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/chatType" }
        }
      }
    },
    "chatType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "chat_id_label"],
      "properties": {
        "type": { "enum": ["private", "group"] },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "chat_id_label": { "$ref": "#/$defs/nonEmptyString" },
        "chat_id_hint": { "$ref": "#/$defs/nonEmptyString" },
        "prefix": {
          "description": "拼到用户输入号码前的会话 ID 前缀，不能含首尾空白。",
          "type": "string",
          "pattern": "^\\S([\\s\\S]*\\S)?$"
        }
      }
    }
  }
}
